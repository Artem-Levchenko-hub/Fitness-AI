# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# editor / IDE
.vscode/
.idea/
*.swp
.DS_Store

# test artifacts
/playwright-report
/playwright/.cache
/test-results
/coverage

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code local tooling (worktrees w/ node_modules, rescue snapshots, session state) — never commit
.claude/
.omc/

# RAG knowledge base — PDF исходники держим локально и на VPS, не в git
/books

# pnpm 11 build-approval file — local only, breaks pnpm 9 on prod
pnpm-workspace.yaml

# DEV-ONLY login helper (backdoor) — local only, never commit
scripts/dev-login.ts

# verification session minter (uses prod secret) — local only
scripts/issue-session.mjs

# Playwright MCP run artifacts
.playwright-mcp/
