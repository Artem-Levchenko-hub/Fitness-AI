{
  "name": "vibe-trainer-desktop",
  "version": "1.2.3",
  "description": "Vibe-trainer — десктоп-приложение для силовых тренировок с AI-анализом",
  "author": "fitnesss.online",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "assets": "node scripts/gen-assets.mjs",
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "jimp": "^1.6.0",
    "png-to-ico": "^2.1.0",
    "sharp": "0.35.3"
  },
  "build": {
    "appId": "ru.leadgenerator.vibetrainer",
    "productName": "Vibe-trainer",
    "copyright": "© fitnesss.online",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "security-policy.js",
      "auto-updater.js",
      "update-verifier.js",
      "update-public-key.pem",
      "preload.js",
      "renderer/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Artem-Levchenko-hub",
        "repo": "Fitness-AI"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "Vibe-trainer-Windows-x64-Setup-v${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/sidebar.bmp",
      "uninstallerSidebar": "build/sidebar.bmp",
      "installerHeader": "build/header.bmp",
      "license": "build/license.txt",
      "language": "1049",
      "shortcutName": "Vibe-trainer",
      "uninstallDisplayName": "Vibe-trainer"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
