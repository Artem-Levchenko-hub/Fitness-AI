# ───────── База данных ─────────
# Локальный Postgres (на сервере уже стоит PG 15.16). Для dev — Docker Postgres
# или локальная инсталляция. Создать БД `fitness_saas` и пользователя.
#   docker run -d --name fitness-pg -p 5432:5432 \
#     -e POSTGRES_USER=fitness -e POSTGRES_PASSWORD=fitness \
#     -e POSTGRES_DB=fitness_saas postgres:15-alpine
DATABASE_URL=postgresql://fitness:fitness@localhost:5432/fitness_saas

# ───────── Auth.js (NextAuth v5) ─────────
# Сгенерировать: npx auth secret  (или openssl rand -base64 32)
AUTH_SECRET=

# Только для production за reverse proxy (nginx). На localhost оставить пустым.
AUTH_URL=https://app.lead-generator.ru
AUTH_TRUST_HOST=true

# ───────── Resend (email magic link) ─────────
# https://resend.com/api-keys (free tier: 100 писем/день, 3000/месяц)
RESEND_API_KEY=
# Должен быть подтверждённый домен в Resend Dashboard:
EMAIL_FROM=Fitness SaaS <noreply@app.lead-generator.ru>

# ───────── DeepSeek (AI-анализ тренировок) ─────────
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ───────── Redis (rate limit для AI route, опционально) ─────────
# Для prod рекомендуется. Локально:
#   docker run -d --name fitness-redis -p 6379:6379 redis:7-alpine
REDIS_URL=redis://localhost:6379

# ───────── Stripe (биллинг) ─────────
# https://dashboard.stripe.com/test/apikeys (используем test mode для разработки)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Price IDs из Stripe Dashboard → Products
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# ───────── Cron secret ─────────
# Любая случайная строка ≥16 символов. Используется для аутентификации
# node-cron worker → AI-анализ route handler (внутренний вызов).
CRON_SECRET=

# ───────── App ─────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
