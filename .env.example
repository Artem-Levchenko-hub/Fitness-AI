# ───────── База данных ─────────
# Локальный Postgres (на сервере уже стоит PG 15.16). Для dev — Docker Postgres
# или локальная инсталляция. Создать БД `fitness_saas` и пользователя.
#   docker run -d --name fitness-pg -p 5432:5432 \
#     -e POSTGRES_USER=fitness -e POSTGRES_PASSWORD=fitness \
#     -e POSTGRES_DB=fitness_saas postgres:15-alpine
DATABASE_URL=postgresql://fitness:fitness@localhost:5432/fitness_saas

# ───────── Auth.js (NextAuth v5) ─────────
# Сгенерировать: npx auth secret  (или openssl rand -base64 32)
AUTH_SECRET=

# Только для production за reverse proxy (nginx). На localhost оставить пустым.
# Production: https://fitnesss.online
AUTH_URL=
AUTH_TRUST_HOST=true

# ───────── Resend (email magic link) ─────────
# https://resend.com/api-keys (free tier: 100 писем/день, 3000/месяц)
RESEND_API_KEY=
# Должен быть подтверждённый домен в Resend Dashboard:
EMAIL_FROM=Fitness AI <noreply@mail.fitnesss.online>

# ───────── AI (Gemini или OpenAI-compatible gateway) ─────────
# Вариант 1: Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Вариант 2: OpenRouter / ProxyAPI / VseGPT
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=deepseek/deepseek-chat
AI_EMBED_MODEL=emb-openai/text-embedding-3-small

# ───────── Redis (rate limit для AI route, опционально) ─────────
# Для prod рекомендуется. Локально:
#   docker run -d --name fitness-redis -p 6379:6379 redis:7-alpine
REDIS_URL=redis://localhost:6379

# ───────── ЮKassa: платежи, баланс и подписка ─────────
# Начинайте только с тестового магазина. Для боевого запуска владелец отдельно
# меняет mode на live после проверки чеков, оферты и webhook.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_MODE=test
# 1 = без НДС. Перед live обязательно сверить код с бухгалтером.
YOOKASSA_VAT_CODE=1
# В live рекомендуется true при корректно настроенном trusted reverse proxy.
YOOKASSA_WEBHOOK_IP_CHECK=false

# Платежи включаются только когда заполнены ключи и реквизиты продавца.
BILLING_ENABLED=false
SUBSCRIPTION_ENABLED=false
AI_COACH_PRICE_KOPECKS=2200

# Должны в точности совпадать с офертой и кабинетом ЮKassa.
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_INN=
# ОГРН (13 цифр) или ОГРНИП (15 цифр); для самозанятого можно оставить пустым.
LEGAL_OPERATOR_REGISTRATION_ID=
LEGAL_OPERATOR_ADDRESS=
LEGAL_SUPPORT_EMAIL=
LEGAL_OFFER_VERSION=2026-07-30
# true — только после проверки оферты/политики владельцем или юристом.
LEGAL_DOCUMENTS_APPROVED=false

# ───────── Cron secret ─────────
# Любая случайная строка ≥16 символов. Используется для аутентификации
# node-cron worker → AI-анализ route handler (внутренний вызов).
CRON_SECRET=

# ───────── App ─────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
